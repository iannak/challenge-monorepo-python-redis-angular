{
  "openapi": "3.0.0",
  "info": {
    "title": "Challenge API",
    "version": "1.0.0",
    "description": "API para autenticação, produtos, fila e worker."
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token JWT gerado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso." },
          "400": { "description": "Email e senha obrigatórios." },
          "409": { "description": "Email já cadastrado." }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout do usuário (descarta token)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logout realizado." },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Listar produtos",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de produtos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "price": { "type": "number" },
                      "marca": { "type": "string" },
                      "created_at": { "type": "string" },
                      "updated_at": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Não autorizado" }
        }
      },
      "post": {
        "summary": "Criar produto (enfileira)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "marca": { "type": "string" }
                },
                "required": ["name", "price", "marca"]
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Operação enfileirada" },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/products/{id}": {
      "put": {
        "summary": "Atualizar produto (enfileira)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "marca": { "type": "string" }
                },
                "required": ["name", "price", "marca"]
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Operação enfileirada" },
          "401": { "description": "Não autorizado" }
        }
      },
      "delete": {
        "summary": "Excluir produto (enfileira)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "202": { "description": "Operação enfileirada" },
          "401": { "description": "Não autorizado" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
